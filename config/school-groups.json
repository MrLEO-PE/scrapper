{
  "//": "Big school groups. A school matching one is shown as e.g. 'k12 · Nord Anglia' in the School Type column, because who owns a school decides its pay scale, its HR and whether you can transfer between campuses.",
  "//match": "Case-insensitive regular expression, tested against the school name and its website. Keep it tight — a loose pattern will claim schools the group does not own.",
  "//note": "Cognia is deliberately absent: it is an accreditation agency, not an owner. Cognita, one letter away, is a group.",
  "groups": [
    { "name": "Nord Anglia", "match": "nordanglia|nord ?anglia" },
    { "name": "Cognita", "match": "cognita" },
    { "name": "GEMS Education", "match": "\\bgems\\b" },
    { "name": "Dulwich College International", "match": "dulwich" },
    { "name": "Harrow International", "match": "harrow" },
    { "name": "Wellington College International", "match": "wellington college" },
    { "name": "Shrewsbury International", "match": "shrewsbury" },
    { "name": "Brighton College International", "match": "brighton college" },
    { "name": "Malvern College International", "match": "malvern college" },
    { "name": "Repton International", "match": "repton" },
    { "name": "Yew Chung / Yew Wah", "match": "yew ?chung|yew ?wah|ycis|ywies" },
    { "name": "EtonHouse", "match": "etonhouse|eton ?house" },
    { "name": "Invictus Education", "match": "invictus" },
    { "name": "Maple Bear", "match": "maple ?bear" },
    { "name": "SABIS", "match": "sabis" },
    { "name": "KinderWorld / SIS", "match": "kinderworld" },
    { "name": "Inspired Education", "match": "inspired education" },
    { "name": "International Schools Partnership", "match": "internationalschoolspartnership" },
    { "name": "BASIS International", "match": "basis ?international|basisinternational" },
    { "name": "Global Indian International", "match": "global indian international" },
    { "name": "Aga Khan Academies", "match": "aga ?khan" },
    { "name": "United World Colleges", "match": "\\buwc\\b|united world college" },
    { "name": "Nobel Education", "match": "nobel ?education" },
    { "name": "Esol Education", "match": "esol education" },
    { "name": "Taaleem", "match": "taaleem" },
    { "name": "Beacon Education", "match": "beacon ?education" },
    { "name": "ISP China / Yago", "match": "yago ?school" },
    { "name": "Raffles Education", "match": "raffles ?(?:education|institution|american)" },
    { "name": "Stamford American", "match": "stamford american" },
    { "name": "ACG Education", "match": "\\bacg\\b" },
    { "name": "Fairview International", "match": "fairview international" },
    { "name": "Regent International", "match": "regents? international" }
  ]
}
